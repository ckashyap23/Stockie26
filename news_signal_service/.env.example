# Copy to .env for local runs. On Railway set these as service Variables.

# --- API security (required in production) ---
# Comma-separated keys accepted in the X-API-Key header.
API_KEYS=
# Local development only; never set in production.
ALLOW_UNAUTHENTICATED=false

# --- Storage ---
# Railway: attach a Volume at /data (the Dockerfile defaults DATA_DIR=/data).
# DATA_DIR=./var

# --- Ingestion ---
NEWSAPI_KEY=
HTTP_TIMEOUT_SECONDS=20

# --- LLM judge (all seeds). Provider: gemini | groq | openai | anthropic | openrouter | openai_compat ---
# Free options: a Gemini key from aistudio.google.com, or a Groq key from console.groq.com. Verify: python -m app.llm.check
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_MODEL=                 # override the provider's default model id
# LLM_BASE_URL=              # only for openai_compat
LLM_MIN_INTERVAL_SECONDS=4
LLM_MAX_CALLS_PER_RUN=40

# --- Aggregation ---
AGGREGATE_SCALE=3.0
NEUTRAL_BAND=0.05

# --- Dedupe / relevance: tfidf | sentence_transformers (needs requirements-ml.txt) ---
EMBEDDER=sentence_transformers   # benchmarked default; tfidf = weak no-dependency fallback
# --- Full text ---
ENABLE_FULLTEXT=true
# --- Aggregation gates ---
MIN_CONFIDENCE=0.35
MIN_SIGNAL=0.05
GROUP_DECAY=0.5

# --- Editable config folder (seeds, feeds, heavyweights, filters, tuning). Railway: /data/config (on the Volume) ---
# CONFIG_DIR=./data

# --- News window (IST) and hosting ---
# WINDOW_START_TIME=15:30      # on the previous weekday
# WINDOW_END_TIME=08:30        # on the target day
# WINDOW_PREVIOUS_DAY=previous_weekday   # or calendar_day
# INGEST_LOOKBACK_HOURS=36
# Cron trigger (app.trigger): SERVICE_URL=https://your-service.up.railway.app  TRIGGER_API_KEY=<one of API_KEYS>
