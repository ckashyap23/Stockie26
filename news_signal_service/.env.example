# News-signal service. Copy to .env for local runs; on Railway set these as service Variables.
# Only the values below need setting: every other setting has a working default in app/config.py.

# --- LLM judge (required): one provider and its key. Provider: gemini | groq | openai | anthropic | openrouter | openai_compat ---
# Free options: a Gemini key from aistudio.google.com, or a Groq key from console.groq.com. Verify with: python -m app.llm.check
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GROQ_API_KEY= / OPENAI_API_KEY= / ANTHROPIC_API_KEY= ; LLM_MODEL=<override the default model id> ; LLM_BASE_URL=<openai_compat only>

# --- Where the score goes (required to publish): the technical service's database ---
NEWS_SCORE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require   # falls back to SUPABASE_CONN_STR

# --- API access (the /v1 routes; /health is always open) ---
# Comma-separated keys accepted in the X-API-Key header. With none set, every /v1 route returns 503; the scheduler does not need them.
API_KEYS=
# Local development only; never set on a hosted service.
# ALLOW_UNAUTHENTICATED=true

# --- Hosting (Railway: attach a Volume at /data; the Dockerfile already sets DATA_DIR=/data) ---
# SCHEDULER_ENABLED=1        # ingest every 30 min + the 08:30 IST weekday run (docs/RAILWAY.md)
# RAILWAY_RUN_UID=0          # lets the container write to the Volume

# --- Optional ---
# NEWSAPI_KEY=               # extra headline source
# DATA_DIR=./var             # local default
# CONFIG_DIR=/data/config    # keep editable seeds/feeds on the Volume; default is the copy packaged in the image
# WINDOW_START_TIME=15:30  WINDOW_END_TIME=08:30  WINDOW_PREVIOUS_DAY=previous_weekday   # the news window (IST); these are the defaults
# Tuning, all with defaults: EMBEDDER, ENABLE_FULLTEXT, AGGREGATE_SCALE, NEUTRAL_BAND, MIN_CONFIDENCE, MIN_SIGNAL, GROUP_DECAY,
# LLM_MIN_INTERVAL_SECONDS, LLM_MAX_CALLS_PER_RUN, HTTP_TIMEOUT_SECONDS, INGEST_LOOKBACK_HOURS.
# Cron trigger (app.trigger): SERVICE_URL=https://your-service.up.railway.app  TRIGGER_API_KEY=<one of API_KEYS>
