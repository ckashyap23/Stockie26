# Service-owned configuration. Set real values in the hosting environment or .env.
HOST=127.0.0.1
PORT=5001
# Set before exposing the service outside localhost. Every route except /health
# then requires Authorization: Bearer <value> (including dashboard requests).
TECHNICAL_ANALYSIS_API_KEY=
# Optional absolute writable path. Default: technical_analysis_service/output
# TECHNICAL_ANALYSIS_OUTPUT_DIR=C:/stockie/technical-output
# Optional absolute .env location. Default: this service's .env, never a parent .env.
# TECHNICAL_ANALYSIS_ENV_FILE=C:/stockie/technical.env
DATABASE_PROVIDER=supabase
SUPABASE_CONN_STR=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
KITE_API_KEY=
KITE_API_SECRET=
# Paper trading reads live market quotes but records simulated trades in the DB.
KITE_ACCESS_TOKEN_PATH=kite_access_token.txt
# Optional automated token login; install the broker-login extra and Chromium.
# KITE_AUTO_LOGIN=1
# KITE_LOGIN_HEADLESS=1
# KITE_USER_ID=
# KITE_PASSWORD=
# KITE_TOTP_SECRET=
# KITE_2FA_MODE=totp
# KITE_REDIRECT_HOST=127.0.0.1
# Use a registered callback port distinct from dashboard 5000 and backend 5001.
# KITE_REDIRECT_PORT=5002
# KITE_TOKEN_WAIT_SECONDS=180
# Optional Azure SQL adapter instead of Supabase; install the azure extra + ODBC driver.
# DATABASE_PROVIDER=azure_sql
# AZURE_SQL_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=HOST;Database=DB;Uid=USER;Pwd=PASSWORD;Encrypt=yes;
TARGET_UNDERLYINGS=NIFTY,BANKNIFTY
UNDERLYING_LOOKBACK_DAYS=3
NIFTY_TARGET_PCT=0.006
NIFTY_TARGET_PCT_RELAXED=0.004
TARGET_PCT_EFFECTIVE=0.006
SL_PCT_EFFECTIVE=0.004
PAPER_TRADING_CAPITAL=100000
PAPER_CAPITAL_PER_TRADE_PCT=1
SL_DIVIDER=10
N_CAP=5
# Maintenance option holding-window setting; not the paper monitor's exit policy.
# TRADE_HORIZON_DAYS=1
STRATEGY_FEATURE_CLEANUP_ENABLED=1
MACRO_TRAILING_WINDOW=60
# Optional email reporting, used only when an explicit notification job is run.
# NOTIFY_EMAIL_FROM=
# NOTIFY_EMAIL_PASSWORD=
# NOTIFY_EMAIL_TO=
# NOTIFY_SMTP_HOST=smtp.gmail.com
# NOTIFY_SMTP_PORT=587
