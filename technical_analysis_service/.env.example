# Technical-analysis service. Copy to .env locally; on Railway set these as service Variables.
# Only the values below need setting: everything not listed has a built-in default (see common/config.py).

# --- Database (required) ---
DATABASE_PROVIDER=supabase
SUPABASE_CONN_STR=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# --- Kite (required) ---
KITE_API_KEY=
KITE_API_SECRET=
# Unattended daily token login (the kite-token job; needs the broker-login extra + Chromium, both in the Docker image).
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=
# The login listens on this host:port for Kite's redirect, so it must match the redirect URL registered in your Kite app.
KITE_REDIRECT_HOST=127.0.0.1
KITE_REDIRECT_PORT=5001

# --- Strategy (required: no default, or the default differs from the live setting) ---
NIFTY_TARGET_PCT=0.006
TARGET_PCT_EFFECTIVE=0.006
SL_PCT_EFFECTIVE=0.004

# --- Morning email (job morning-email, 09:32 IST) through Resend ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Stockie <signals@your-verified-domain.com>
NOTIFY_EMAIL_TO=you@example.com
# For the attached news-articles CSV: the news service's base URL and one of its API_KEYS.
# On Railway use the private address, e.g. http://<news-service-name>.railway.internal:8080
NEWS_SERVICE_URL=
NEWS_API_KEY=

# --- Web access ---
# Every route except /health is refused unless a key is set (clients send "Authorization: Bearer <key>") ...
TECHNICAL_ANALYSIS_API_KEY=
# ... or this is set, for trusted local use only. Never set it on a hosted service. flask_app.py sets it itself (127.0.0.1 only).
# TECHNICAL_ANALYSIS_ALLOW_UNAUTHENTICATED=1

# --- Hosting (Railway only: do NOT set these on a laptop that still runs the Windows scheduled tasks) ---
# TECHNICAL_ANALYSIS_SCHEDULER=1   # run the daily job roster inside the web service (docs/railway.md)
# RAILWAY_RUN_UID=0                # lets the container write to the Volume mounted at /data

# --- Optional ---
# TECHNICAL_ANALYSIS_ENV_FILE=C:/stockie/technical.env      # default: this folder's .env, never a parent
# TECHNICAL_ANALYSIS_OUTPUT_DIR=C:/stockie/technical-output # default: ./output (the Docker image uses /data/output)
# Other Settings with working defaults, set only to change them: TARGET_UNDERLYINGS, NIFTY_TARGET_PCT_RELAXED, PAPER_TRADING_CAPITAL,
# PAPER_CAPITAL_PER_TRADE_PCT, SL_DIVIDER, N_CAP, UNDERLYING_LOOKBACK_DAYS, MACRO_TRAILING_WINDOW, TRADE_HORIZON_DAYS.
# Azure SQL instead of Supabase: DATABASE_PROVIDER=azure_sql, AZURE_SQL_CONN_STR (install the azure extra + ODBC driver).
